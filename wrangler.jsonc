{
  // Change "name" to match your Cloudflare Workers project name
  "name": "fnb-pwa",
  "main": "worker.js",
  "compatibility_date": "2026-04-14",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "."
  },
  // R2 bucket for media (store logo, banner, item video clips)
  // Create the bucket first: wrangler r2 bucket create fnb-pwa-media
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "fnb-pwa-media",
      "preview_bucket_name": "fnb-pwa-media-dev"
    }
  ]
  // After deploying, set the upload secret:
  //   wrangler secret put UPLOAD_SECRET
  // Then save the same value in admin → Dev ⚙ → Video Upload Secret
}
