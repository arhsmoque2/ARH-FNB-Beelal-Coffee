{
  "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint-cli2/main/schema/markdownlint-cli2-config-schema.json",
  "config": {
    "default": true,
    "MD013": false,
    "MD024": false,
    "MD033": false,
    "MD034": false,
    "MD040": false,
    "MD041": false,
    "MD060": false
  },
  "globs": ["**/*.md", ".github/**/*.md"],
  "ignores": ["node_modules/**", ".wrangler/**", "dist/**"]
}
